# ---------------------------------------------------------------- Email
# All forms (contact, laser wire order, reviews) send through ONE provider.
# Set SENDGRID_API_KEY (recommended) OR RESEND_API_KEY.
#
# SendGrid is what the old WordPress site uses (SMTP relay, from
# no-reply@iasavionics.ca), so iasavionics.ca is already authenticated there
# and nothing in DNS needs to change. In SendGrid: Settings > API Keys >
# Create API Key, "Restricted Access" with only Mail Send enabled.
SENDGRID_API_KEY=
RESEND_API_KEY=

# Sender shown on emails. Defaults to the same sender the old site used:
#   Innovative Aerospace Services Ltd <no-reply@iasavionics.ca>
MAIL_FROM=

# Inbox for contact-form inquiries and new-review alerts.
# Defaults to kim@iasavionics.ca.
CONTACT_TO_EMAIL=

# Inbox for laser marked wire quotation requests. Defaults to kim@iasavionics.ca.
LASER_WIRE_TO_EMAIL=

# ---------------------------------------------------------- Testimonials
# Storage for reviews submitted on /testimonials. On Vercel: Storage tab >
# Upstash for Redis (free tier) > Connect; it sets these two automatically.
# Without them (outside Vercel) reviews are stored in .data/ for local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Signs the "remove this review" links emailed to IAS. Any long random string.
TESTIMONIALS_SECRET=

# Once IAS has Google reviews: the Google Business Profile "write a review"
# link. Adds a "Review Us on Google" button to /testimonials.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
